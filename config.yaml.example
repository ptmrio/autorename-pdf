# AutoRename-PDF Configuration (v2)
# Copy this file to config.yaml and fill in your values.

# AI Provider Configuration
ai:
  provider: "openai"              # openai, anthropic, gemini, xai, ollama
  model: "gpt-5.6-luna"          # Model name (provider-specific)
  api_key: "your-api-key-here"   # Not needed for ollama
  base_url: ""                    # Custom base URL (optional, for proxies)
  temperature: 0.0                # Ignored for OpenAI/Anthropic native parse
  max_retries: 2                  # Retry failed API calls

# --- API Key Options ---
# You can store your API key in two ways:
#
# Method 1 — Directly in this file (simple, portable):
#   api_key: "sk-your-actual-key-here"
#
# Method 2 — Via environment variable (secure, easy to switch):
#   api_key: "${OPENAI_API_KEY}"
#
# With Method 2, set the variable in a .env file next to this config:
#   OPENAI_API_KEY=sk-your-actual-key-here
#   ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# Any string value in this file can reference env vars with ${VAR_NAME}.
# See .env.example for a template.

# PDF Processing
pdf:
  max_pages: 3                    # Max pages to process per PDF
  ocr: false                      # false / true / "auto" — PaddleOCR for scanned PDFs
  vision: false                   # false / true / "auto" — send page images to LLM
  text_quality_threshold: 0.3     # Triggers OCR/vision when set to "auto"
  outgoing_invoice: "AR"          # Outgoing invoice / Ausgangsrechnung
  incoming_invoice: "ER"          # Incoming invoice / Eingangsrechnung

# PaddleOCR Configuration (optional, install via setup.ps1)
paddleocr:
  venv_path: ""                   # Auto-detected if empty
  language: "en"                   # OCR language code (one language per instance)
                                   #   "en" = English-only model (smaller, faster)
                                   #   "de","fr","es",etc. = Latin model (all 59 Latin-script langs incl. English)
                                   #   "ch" = Chinese model (also handles Japanese and English)
                                   #   For European docs, use your country code -- it covers English too.
  device: "auto"                  # "auto" (recommended), "cpu", or "gpu"
  # detection_model: ""           # Detection model (default: PP-OCRv6_small_det)
                                  #   Use "PP-OCRv5_server_det" for higher accuracy
                                  #   on complex layouts (uses more RAM)
  # det_limit_side_len: 736       # Max image side for detection (lower = less RAM)
  # cpu_threads: 4                # CPU threads for OCR inference (default: 4)

# Company Information
company:
  name: "Your Company Name"       # Your company name (prevents it being extracted as counterparty)

# Output Settings
output:
  language: "English"             # Language for document type descriptions
  date_format: "%Y%m%d"          # strftime format for filenames (YYYYMMDD)

# Extraction profile; rename --profile overrides this for one run.
profile: business
# Overlay built-ins or declare custom profiles here; see README examples.
# Three-component opt-out (both settings required):
#   profiles:
#     business:
#       template: "{document_date} {company_name} {document_type}"
#       truncate_field: company_name
# Optional invoice id, keeping the printed amount in description:
#   profiles:
#     business:
#       fields:
#         invoice_id:
#           description: "Copy the printed invoice number exactly, without an Invoice or Rechnung label. Empty if absent or the document is not an invoice."
#       template: "{document_date} {company_name} {document_type} {description} {invoice_id}"
#       truncate_field: description
profiles: {}

# Optional global instructions, appended verbatim to the profile prompt.
# Business description already contains a printed invoice total.
# Remove older amount-appending document_type instructions to avoid duplicates.
prompt_extension: ""
