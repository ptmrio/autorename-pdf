{
  "name": "autorename-pdf-gui",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:css": "tailwindcss -i ./src/css/index.css -o ./assets/css/output.css --minify",
    "colors": "node scripts/generate-colors.js --config colors.json --output src/css/generated-colors.css --format css",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate-app-icons.cjs --config icons.config.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6"
  },
  "devDependencies": {
    "@tabler/icons": "^3.36.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitest/coverage-v8": "^5.0.0",
    "culori": "^4.0.2",
    "jsdom": "^29.1.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
